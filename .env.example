# Database Configuration
MONGODB_URI=mongodb://localhost:27017/profilebuilder

# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# Application Configuration
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Security Configuration
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here
# Optional: Comma-separated list of previous encryption keys for key rotation support
ENCRYPTION_PREVIOUS_KEYS=previous_key1,previous_key2

# Email Configuration (if needed)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# External API Keys (use secrets manager in production)
OPENAI_API_KEY=your_openai_api_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# NOTE: Never commit actual secrets to version control.
# Use environment variables or a secrets manager like AWS Secrets Manager, Vault, etc.
# For development, copy this file to .env.local and fill in actual values.