{
  "name": "careerverve",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prettier": "prettier --write .",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:coverage": "jest --coverage",
    "test:performance": "npm run test:performance:api && npm run test:performance:db && npm run test:performance:cache",
    "test:performance:api": "node benchmarks/api-benchmark.js",
    "test:performance:db": "node benchmarks/db-benchmark.js",
    "test:performance:cache": "node benchmarks/cache-benchmark.js",
    "test:load": "artillery run benchmarks/load-test.yml",
    "test:load:stress": "artillery run benchmarks/stress-test.yml",
    "test:load:spike": "artillery run benchmarks/spike-test.yml",
    "test:load:endurance": "artillery run benchmarks/endurance-test.yml",
    "test:load:all": "npm run test:load && npm run test:load:stress && npm run test:load:spike",
    "type-check": "tsc --noEmit",
    "security:audit": "npm audit --audit-level=moderate",
    "security:audit:fix": "npm audit fix",
    "security:check": "npm run security:audit && npm run lint:security",
    "lint:security": "echo 'Running security linting...'",
    "pre-commit": "npm run lint && npm run type-check && npm run security:audit",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "deps:audit:full": "npm audit --audit-level=info",
    "deps:audit:critical": "npm audit --audit-level=critical",
    "deps:audit:high": "npm audit --audit-level=high",
    "deps:audit:fix:force": "npm audit fix --force",
    "deps:install:ci": "npm ci --prefer-offline --no-audit",
    "deps:install:clean": "rm -rf node_modules package-lock.json && npm install",
    "deps:licenses": "npm ls --depth=0 --json | jq '.dependencies | to_entries | map({name: .key, license: .value.license})'",
    "deps:tree": "npm ls --depth=0",
    "deps:vulnerabilities": "npm audit --json | jq '.vulnerabilities | keys'",
    "deps:health": "npm audit --audit-level=moderate --json | jq '{total: .metadata.vulnerabilities.total, info: .metadata.vulnerabilities.info, low: .metadata.vulnerabilities.low, moderate: .metadata.vulnerabilities.moderate, high: .metadata.vulnerabilities.high, critical: .metadata.vulnerabilities.critical}'",
    "deps:report": "npm run deps:check && echo '---' && npm run deps:health"
  },
  "dependencies": {
    "@whatwg-node/fetch": "^0.10.10",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "docx": "^9.5.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mammoth": "^1.11.0",
    "mongoose": "^8.18.0",
    "mongoose-encryption": "^2.1.2",
    "next": "^14.2.32",
    "next-auth": "^4.24.11",
    "next-i18next": "^15.4.2",
    "next-safe": "^3.5.0",
    "pdfjs-dist": "^5.4.149",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.17.1",
    "react": "^18",
    "react-dom": "^18",
    "react-flags-select": "^2.5.0",
    "redis": "^4.6.13",
    "uuid": "^10.0.0",
    "winston": "^3.14.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/redis": "^4.0.11",
    "@types/uuid": "^10.0.0",
    "@types/winston": "^2.4.4",
    "artillery": "^2.0.24",
    "dotenv": "^17.2.2",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "mongodb-memory-server": "^10.2.1",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
