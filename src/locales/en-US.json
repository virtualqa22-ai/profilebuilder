        "phone": { "label": "Phone Number", "placeholder": "e.g., (555) 123-4567" },
        "linkedin": { "label": "LinkedIn Profile", "placeholder": "e.g., linkedin.com/in/johndoe" },
        "github": { "label": "GitHub Profile", "placeholder": "e.g., github.com/johndoe" },
