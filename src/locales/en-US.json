{
  "locale": "en-US",
  "name": "United States",
  "dateFormat": "MM/DD/YYYY",
  "sections": {
    "personalInfo": {
      "label": "Personal Information",
      "fields": {
        "name": { "label": "Full Name", "placeholder": "John Doe" },
        "email": { "label": "Email Address", "placeholder": "john.doe@example.com" },
        "phone": { "label": "Phone Number", "placeholder": "(555) 123-4567" },
        "linkedin": { "label": "LinkedIn Profile", "placeholder": "linkedin.com/in/johndoe" },
        "github": { "label": "GitHub Profile", "placeholder": "github.com/johndoe" },
        "website": { "label": "Personal Website", "placeholder": "johndoe.com" }
      },
      "order": ["name", "email", "phone", "linkedin", "github", "website"]
    },
    "summary": {
      "label": "Summary",
      "placeholder": "A brief summary of your skills and experience."
    },
    "workExperience": {
      "label": "Work Experience",
      "fields": {
        "title": { "label": "Job Title", "placeholder": "Software Engineer" },
        "company": { "label": "Company", "placeholder": "Acme Corporation" },
        "location": { "label": "Location", "placeholder": "San Francisco, CA" },
        "startDate": { "label": "Start Date", "placeholder": "Jan 2020" },
        "endDate": { "label": "End Date", "placeholder": "Dec 2022 or Present" },
        "description": { "label": "Responsibilities", "placeholder": "Describe your responsibilities and achievements." }
      },
      "order": ["title", "company", "location", "startDate", "endDate", "description"]
    },
    "education": {
      "label": "Education",
      "fields": {
        "degree": { "label": "Degree", "placeholder": "Bachelor of Science" },
        "major": { "label": "Major", "placeholder": "Computer Science" },
        "university": { "label": "University", "placeholder": "University of California, Berkeley" },
        "location": { "label": "Location", "placeholder": "Berkeley, CA" },
        "startDate": { "label": "Start Date", "placeholder": "Sep 2018" },
        "endDate": { "label": "End Date", "placeholder": "May 2022" }
      },
      "order": ["degree", "major", "university", "location", "startDate", "endDate"]
    },
    "skills": {
      "label": "Skills",
      "placeholder": "JavaScript, React, Node.js"
    },
    "projects": {
      "label": "Projects",
      "placeholder": "Describe your projects."
    },
    "awardsCertifications": {
      "label": "Awards and Certifications",
      "placeholder": "List your awards and certifications."
    }
  }
}
