        "university": { "label": "University", "placeholder": "e.g., University of California, Berkeley" },
        "location": { "label": "Location", "placeholder": "e.g., Berkeley, CA" },
        "startDate": { "label": "Start Date", "placeholder": "e.g., Sep 2018" },
        "endDate": { "label": "End Date", "placeholder": "e.g., May 2022" }
      },
      "order": ["degree", "major", "university", "location", "startDate", "endDate"]
    },
    "skills": {
      "label": "Skills",
      "placeholder": "e.g., JavaScript, React, Node.js"
